# Application Settings
APP_NAME={{cookiecutter.project_name}}
DESCRIPTION="{{cookiecutter.app_description}}"

# Logger Settings
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG

# CORS Settings
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://yourdomain.com

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-redis-password-if-needed

# Queue Worker Settings
WORKER_COUNT=2
RESULT_TTL=3600
DEFAULT_QUEUE=default
QUEUE_NAMES=default,high,low
JOB_TIMEOUT=600

# API Key Authentication (base64 encoded JSON)
# See src/{{cookiecutter.project_name}}/auth/secrets_b64.py for encoding/decoding utilities
# Format: {"key": {"username": "name", "roles": ["admin", "user"]}}
# To encode: python -c "import base64, json; print(base64.b64encode(json.dumps({'test': {'username': 'admin', 'roles': ['admin', 'user']}}).encode()).decode())"
API_KEYS=eyJ0ZXN0Ijp7InVzZXJuYW1lIjoiSm9uYXRoYW4iLCJyb2xlcyI6WyJhZG1pbiIsInVzZXIiXX0sInRlc3QyIjp7InVzZXJuYW1lIjoiYm9iIiwicm9sZXMiOlsidXNlciJdfX0=

# OAuth Settings (Optional - only needed if using OAuth authentication)
# Get these from your OAuth provider (GitHub, Google, Microsoft, GitLab, LinkedIn, Discord)
OAUTH_PROVIDER=github
OAUTH_SECRET_KEY=your-secret-key-min-32-chars-change-in-production
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
